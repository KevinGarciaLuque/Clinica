{
  "redirects": [
    {
      "source": "/:path*",
      "missing": [
        { "type": "host", "value": "medickg.com" },
        { "type": "host", "value": "www.medickg.com" }
      ],
      "destination": "https://medickg.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
