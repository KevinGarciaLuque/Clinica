# ============================================================
#  MULTI-CLÍNICA — Variables de entorno
#  Copia este archivo como  .env  y rellena los valores
# ============================================================

# ---- Servidor ----
PORT=4000
NODE_ENV=development          # development | production

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456789
DB_NAME=clinica

# ---- JWT ----
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_min_32_chars
JWT_EXPIRES=8h

# ---- Multi-tenant ----
# "header"    → usa el header x-clinica-id (ideal en desarrollo)
# "subdomain" → clinica1.tudominio.com (ideal en producción)
TENANT_MODE=header

# ---- CORS ----
# Lista separada por comas de los orígenes permitidos
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- URL del frontend (para links en emails) ----
FRONTEND_URL=http://localhost:5173

# ---- OpenAI (Módulo IA) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Precio máximo de tokens por conversación (protección de costos)
OPENAI_MAX_TOKENS=2000

# ---- Email / SMTP (recordatorios y verificación) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true para puerto 465
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_gmail
EMAIL_FROM="Medic-KG <noreply@medickg.com>"

# ---- Almacenamiento de archivos ----
# "local"      → carpeta uploads/ (desarrollo)
# "cloudinary" → Cloudinary (producción)
STORAGE_MODE=local
UPLOADS_DIR=./uploads

# Cloudinary (si STORAGE_MODE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMS opcional (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890

# ---- Seguridad ----
# Tiempo de inactividad antes de cerrar sesión (minutos) — lo usa el frontend
SESSION_TIMEOUT_MIN=30
# Clave para encriptar datos sensibles adicionales (incluye tokens de Google Calendar)
ENCRYPTION_KEY=cambia_esto_por_32_caracteres_hex

# ---- Google (Calendar sync + Iniciar sesión con Google) ----
# Crear en https://console.cloud.google.com/apis/credentials (gratis)
# Authorized redirect URI: {API_BASE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
